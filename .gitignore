# Scan cache, backups and the installed-version stamp — all machine-local.
.cache/

# Per-install settings (which repo to update from). Detected from the git
# remote when you clone, so it doesn't belong in the repo.
config.json

__pycache__/
*.pyc
*.new

# PyInstaller output. The built exe is a release artifact, not source.
build/
dist/
release/
builds/
*.spec

# Where a built copy keeps its scans when run beside the exe.
data/

# Generated by make_icon.py / icon_concepts.py. icon.ico is committed
# because builds need it; these are just for looking at.
icon-preview.png
icon-approval.png
icon-zoom.png
concepts.png
exe-icon-check.png
icon-fresh-check.png
shipped-icon.png
icon-in-exe.png
check-*.png
