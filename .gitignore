# Scan cache, backups and the installed-version stamp — all machine-local.
.cache/

# Per-install settings (which repo to update from). Detected from the git
# remote when you clone, so it doesn't belong in the repo.
config.json

__pycache__/
*.pyc
*.new

# PyInstaller output. The built exe is a release artifact, not source.
build/
dist/
release/
builds/
*.spec

# Where a built copy keeps its scans when run beside the exe.
data/

# Images produced while designing the icon. icon.ico itself is committed,
# because the app loads it at runtime and builds embed it.
*.png

# Maintainer tools. They build and publish releases, which is no use to anyone
# downloading one, so they live here rather than on the repository page.
release.py
make_icon.py
